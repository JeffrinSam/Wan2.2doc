# ==============================================================================
# Wan2.2-TI2V-5B Docker Image for RTX 5090 (Blackwell Architecture)
# ==============================================================================
# This Dockerfile builds a container optimized for NVIDIA RTX 5090 with:
# - CUDA 12.8 (required for sm_120 compute capability)
# - PyTorch 2.7.0 (Blackwell support)
# - Flash Attention 2 compiled for sm_120 (FA3 doesn't support Blackwell yet)
# - TI2V-5B model support with memory offloading for 32GB VRAM
# ==============================================================================

# ==============================================================================
# STAGE 1: Builder - Compile Flash Attention 2 with sm_120 support
# ==============================================================================
FROM nvcr.io/nvidia/pytorch:25.02-py3 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Set Flash Attention compilation flags for RTX 5090 (sm_120)
ENV FLASH_ATTN_CUDA_ARCHS=120
ENV MAX_JOBS=2
ENV TORCH_CUDA_ARCH_LIST="12.0"

# Install packaging tools needed for compilation
RUN pip install --no-cache-dir packaging wheel ninja

# Compile Flash Attention 2 from source
# This takes 15-20 minutes but is necessary for Blackwell architecture
# Pin to 2.7.3 for API compatibility
RUN pip install flash-attn==2.7.3 --no-build-isolation -v

# ==============================================================================
# STAGE 2: Runtime - Create production image
# ==============================================================================
FROM nvcr.io/nvidia/pytorch:25.02-py3

LABEL maintainer="Wan2.2 TI2V-5B"
LABEL description="Wan2.2 Text-Image-to-Video model optimized for RTX 5090"
LABEL cuda.version="12.8"
LABEL pytorch.version="2.7.0"

# Copy compiled Flash Attention from builder stage
COPY --from=builder /usr/local/lib/python3.12/dist-packages/flash_attn* /usr/local/lib/python3.12/dist-packages/

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements-ti2v-5b.txt /tmp/requirements-ti2v-5b.txt
RUN pip install --no-cache-dir -r /tmp/requirements-ti2v-5b.txt

# Copy application code (excluding model weights - those are mounted as volumes)
COPY wan/ /app/wan/
COPY generate.py /app/
COPY examples/ /app/examples/

# Create output directory
RUN mkdir -p /app/outputs

# Set environment variables for optimal performance
ENV PYTHONUNBUFFERED=1
ENV TQDM_POSITION=-1
ENV TQDM_MININTERVAL=1
ENV CUDA_DEVICE_ORDER=PCI_BUS_ID

# Copy and setup entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Health check to verify GPU and CUDA availability
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD python -c "import torch; assert torch.cuda.is_available(), 'CUDA not available'; assert torch.cuda.get_device_capability()[0] == 12, 'RTX 5090 not detected (expected compute capability 12.x)'" || exit 1

# Expose no ports (runs as CLI tool)

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
